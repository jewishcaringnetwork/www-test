---
/**
 * The plain page header: heading (or the page title) and an optional lead.
 * Almost every page opens with this; landing pages use the hero instead.
 * Its heading is the page's only h1. Styles: src/css/block/page.css.
 */
import type { CollectionEntry } from 'astro:content';

type Header = Extract<
	CollectionEntry<'pages'>['data']['header'],
	{ type: 'header' }
>;

interface Props {
	header: Header;
	/** Page title, the heading when the header has none. */
	title: string;
}

const { header, title } = Astro.props;
---

<header class="page-header | stack container">
	<h1 class="text-h1" dir="auto">{header.heading ?? title}</h1>
	{header.lead && <p class="lead | text-large" dir="auto">{header.lead}</p>}
</header>
