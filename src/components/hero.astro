---
/**
 * The landing-page header (see `hierarchy.hero`): display heading, lead, up to
 * two buttons and a quiet link in one row, and a photo or illustration
 * beside the text when there is one (an illustration is hidden when narrow).
 * Its heading is the page's only h1.
 *
 * Coded pages (the 404) can fill two optional slots: `eyebrow`, shown above
 * the heading, and `actions`, which replaces the buttons built from
 * `hero.actions` (for buttons the content schema can't describe, like one with
 * an icon). Content pages never use them.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TikvaHouseLogo from '~/assets/logos/tikva-house-logo-color.svg';
import Button from '~/components/button.astro';
import Icon from '~/components/icon.astro';

type Hero = Extract<
	CollectionEntry<'pages'>['data']['header'],
	{ type: 'hero' }
>;

interface Props {
	hero: Hero;
}

const { hero } = Astro.props;

/** Program logos a hero can show above its heading, by `brand`. */
const brands = {
	'tikva-house': {
		Logo: TikvaHouseLogo,
		label: 'The Rabbi Ephraim & Etti Rubin Tikva House',
	},
};
const brand = hero.brand && brands[hero.brand];
const slottedActions = Astro.slots.has('actions');
/** An SVG is an illustration: decoration, hidden on narrow screens. */
const illustration = hero.image?.src.format === 'svg' || undefined;
---

<style>
	.hero {
		--container-size: 75rem;

		/* The space below is the page's (src/css/block/page.css) */
		padding-block-start: var(--space-2xl);
		padding-inline: var(--space-l);

		@media (max-width: 60rem) {
			padding-block-start: var(--space-xl);
			padding-inline: var(--space-s);
		}

		:is(h1, p) {
			margin-block-end: 0;
		}
	}

	h1 {
		color: var(--color-text-heading);
	}

	/* Program logo above the heading */
	.brand {
		inline-size: min(20rem, 80%);
		block-size: auto;
	}

	/* The extra space sets the logo apart from the h1 */
	.brand + * {
		--stack-gap: var(--space-l);
	}

	.lead {
		max-inline-size: 40rem;
		color: var(--color-text-secondary);
	}

	/* With a photo: text gets the wider column so the heading stays short */
	.hero:has(> .media) {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		align-items: center;
		gap: var(--space-2xl);

		@media (max-width: 60rem) {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-l);
		}
	}

	/*
	 * 16px between the heading and the lead (a step up from cards' 12px, for
	 * the display heading), and 24px above the action row, as in cards
	 * (src/css/block/card.css). Overrides go on the later child: the stack's
	 * gap is its top margin.
	 */
	.text {
		--stack-gap: var(--space-s);
	}

	/* Without a photo: centered, so the text doesn't hug one side */
	.hero:not(:has(> .media)) .text {
		--stack-halign: center;

		text-align: center;

		.actions {
			justify-content: center;
		}
	}

	/*
	 * Buttons and the quiet link share one row while there's room, and
	 * wrap when there isn't. Same gaps as the CTA band's buttons
	 * (src/components/blocks/cta.astro).
	 */
	.actions {
		--cluster-gap: var(--space-xs) var(--space-m);
		--cluster-valign: center;
		--stack-gap: var(--space-m);
	}

	.quiet {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3xs);
		min-block-size: 44px;
		font-family: var(--font-family-heading);
		font-weight: var(--font-weight-medium);
	}

	/*
	 * Photo or illustration, in a 4:3 frame with no fill of its own, so an
	 * illustration's clear areas show the page. Height is capped at half the
	 * viewport so the next section shows below the fold.
	 */
	.media {
		inline-size: min(100%, 50svh * 4 / 3);
		justify-self: end;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--radius-l);

		/*
		 * An illustration only decorates. On narrow screens, where it would
		 * come after the buttons, it's hidden; a photo is content and stays.
		 */
		&[data-illustration] {
			@media (max-width: 60rem) {
				display: none;
			}
		}

		img {
			position: relative;
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
		}

		/*
		 * Only a broken image renders ::before (Chrome, Firefox), so the
		 * empty-image gray from Leadership's portraits, with the alt text,
		 * shows only when the image fails to load. Safari shows its own
		 * broken-image box instead.
		 */
		img::before {
			content: attr(alt);
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			padding: var(--space-m);
			background: var(--color-surface-sunken);
			color: var(--color-text-secondary);
			text-align: center;
		}
	}
</style>

<header class="hero | container">
	<div class="text | stack">
		{brand && (
			<brand.Logo
				class="brand"
				role="img"
				aria-label={brand.label}
				width={320}
			/>
		)}
		<slot name="eyebrow" />
		<h1 class="text-display" dir="auto">{hero.heading}</h1>
		<p class="lead | text-large" dir="auto">{hero.lead}</p>
		{(slottedActions || hero.actions.length > 0 || hero.link) && (
			<div class="actions | cluster">
				{slottedActions
					? <slot name="actions" />
					: hero.actions.map((action) => (
					 <Button href={action.href} variant={action.variant}>
						 {action.label}
					 </Button>
				 ))}
				{hero.link && (
					<a class="quiet" href={hero.link.href}>
						{hero.link.label}
						<Icon name="arrow-right" size={16} />
					</a>
				)}
			</div>
		)}
	</div>
	{hero.image && (
		<div class="media" data-illustration={illustration}>
			<Image
				src={hero.image.src}
				alt={hero.image.alt}
				widths={[480, 720, 960, 1200]}
				sizes="(max-width: 60rem) 100vw, 36rem"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	)}
</header>
