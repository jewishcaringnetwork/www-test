---
import type { HTMLAttributes } from 'astro/types';
import './button.css';

type BaseProps = {
	inverse?: boolean;
	disabled?: boolean;
	state?: 'hover' | 'focus';
	variant: 'primary' | 'secondary' | 'donate';
};

type AnchorProps = HTMLAttributes<'a'> & {
	href: string;
	type?: never;
};

type ButtonProps = HTMLAttributes<'button'> & {
	href?: never;
	type?: HTMLAttributes<'button'>['type'];
};

type Props = BaseProps & (AnchorProps | ButtonProps);

const { href, disabled, type, variant, state, inverse, class: cn, ...props } =
	Astro.props;

const restProps = href
	? {
		href: disabled ? undefined : href,
		role: disabled ? 'link' as const : undefined,
		tabindex: disabled ? -1 : undefined,
		'aria-disabled': disabled,
	}
	: { type, disabled };

const Tag = href ? 'a' : 'button';
---

<Tag
	{...restProps}
	class:list={['btn', 'text-label', cn]}
	data-inverse={inverse}
	data-state={state}
	data-variant={variant}
	data-icon={Astro.slots.has('icon')
	? Astro.slots.has('default') ? true : 'only'
	: false}
	{...props}
>
	<slot name="icon" />
	<slot />
</Tag>
