---
/**
 * The frame every block sits in: a full-width `<section>` painted with its
 * `background`, holding the page's container, plus the shared section header
 * (`heading` + `intro`) when there is one. The heading is always an h2:
 * blocks sit under the page's h1, and content never picks a level.
 *
 * The page picks each block's background (`sectionBackgrounds`; rules in
 * docs/design/color-blocking.md). Styles: src/css/block/section.css.
 */
import type { HTMLAttributes } from 'astro/types';
import type { SectionBackground } from '~/lib/section-background';

interface Props extends HTMLAttributes<'section'> {
	/** Block type, for styling hooks and debugging. */
	type: string;
	background?: SectionBackground;
	heading?: string;
	intro?: string;
	/** Narrow measure for reading text (prose) instead of the full grid. */
	narrow?: boolean;
}

const {
	type,
	background = 'paper',
	heading,
	intro,
	narrow,
	class: cn,
	...rest
} = Astro.props;
const id = heading
	? `${type}-${
		heading.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(
			/^-|-$/g,
			'',
		)
	}`
	: undefined;
---

<section
	class:list={['section', cn]}
	data-block={type}
	data-background={background}
	data-narrow={narrow}
	aria-labelledby={id}
	{...rest}
>
	<div class="stack container">
		{(heading || intro) && (
			<div class="section-header | stack">
				{heading && <h2 id={id} class="text-h2" dir="auto">{heading}</h2>}
				{intro && <p class="intro | text-large" dir="auto">{intro}</p>}
			</div>
		)}
		<slot />
	</div>
</section>
