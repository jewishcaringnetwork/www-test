---
/**
 * A call-to-action band for one of the page's main asks (`hierarchy.cta`).
 *
 * - `brand`: the loud one. A brand-blue band, h2 in white, inverse buttons
 *   (the gold donate button keeps its fill). Use sparingly, so it stays loud.
 * - `subtle`: a soft gold surface with ordinary buttons and a smaller
 *   heading, for support or a second ask.
 */
import type { CollectionEntry } from 'astro:content';
import Button from '~/components/button.astro';
import Icon from '~/components/icon.astro';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'cta' }
>;

interface Props {
	block: Block;
}

const { block } = Astro.props;
const brand = block.tone === 'brand';
const id = `cta-${
	block.heading.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-')
}`;
---

<style>
	.band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-l) var(--space-xl);
		padding: var(--space-xl);
		border-radius: var(--radius-xl);

		@media (max-width: 48rem) {
			padding: var(--space-l) var(--space-m);
		}

		&[data-tone='brand'] {
			background: var(--color-surface-brand);
			color: var(--color-text-on-brand);

			h2 {
				color: var(--color-text-on-brand);
			}

			.text {
				color: var(--color-blue-100);
			}

			a:not(.btn) {
				color: var(--color-text-on-brand);
				--outline-color: var(--color-brand-gold);
			}
		}

		&[data-tone='subtle'] {
			padding-block: var(--space-l);
			border: 1px solid var(--color-gold-200);
			background: var(--color-surface-accent);

			h2 {
				color: var(--color-text-primary);
			}

			.text {
				color: var(--color-text-secondary);
			}
		}
	}

	.copy {
		--stack-gap: var(--space-2xs);

		flex: 1 1 24rem;
		max-inline-size: 40rem;

		:is(h2, p) {
			margin-block-end: 0;
		}
	}

	.do {
		--stack-gap: var(--space-2xs);
		--stack-halign: start;

		flex: 0 1 auto;
	}

	.actions {
		--cluster-gap: var(--space-xs);
	}

	.quiet {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3xs);
		min-block-size: 44px;
		font-family: var(--font-family-heading);
		font-weight: var(--font-weight-medium);
	}
</style>

<Section type="cta" aria-labelledby={id}>
	<div class="band" data-tone={block.tone}>
		<div class="copy | stack">
			<h2
				id={id}
				class:list={[brand ? 'text-h2' : 'text-h3']}
				dir="auto"
			>
				{block.heading}
			</h2>
			{block.text && (
				<p class:list={['text', brand && 'text-large']} dir="auto">
					{block.text}
				</p>
			)}
		</div>
		<div class="do | stack">
			<div class="actions | cluster">
				{block.actions.map((action) => (
					<Button
						href={action.href}
						variant={action.variant}
						inverse={brand || undefined}
						dir="auto"
					>
						{action.label}
					</Button>
				))}
			</div>
			{block.link && (
				<a class="quiet" href={block.link.href} dir="auto">
					{block.link.label}
					<Icon name="arrow-right" size={16} />
				</a>
			)}
		</div>
	</div>
</Section>
