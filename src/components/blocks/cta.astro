---
/**
 * A call-to-action band for one of the page's main asks (`hierarchy.cta`):
 * a large `.card` (src/css/block/card.css) with the heading and text, then
 * the buttons below them.
 *
 * - `brand`: the loud one. The card's brand tone (blue, white text), an h2
 *   and inverse buttons (the gold donate button keeps its fill). Use
 *   sparingly, so it stays loud.
 * - `subtle`: the plain white card, a smaller heading and ordinary buttons,
 *   for support or a second ask. No gold: the brand-gold fill is the donate
 *   button's.
 */
import type { CollectionEntry } from 'astro:content';
import Button from '~/components/button.astro';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'cta' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;
const brand = block.tone === 'brand';
const id = `cta-${
	block.heading.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-')
}`;
---

<style>
	.copy {
		--stack-gap: var(--space-xs);

		max-inline-size: 40rem;

		:is(h2, p) {
			margin-block-end: 0;
		}
	}

	h2 {
		color: var(--color-text-heading);
	}

	.text {
		color: var(--color-text-secondary);
	}

	/* One or two buttons in a row, wrapping when narrow. No quiet link: a
	 * second, lesser action is a secondary button. */
	.do {
		--cluster-gap: var(--space-xs) var(--space-m);
		--cluster-valign: center;
	}
</style>

<Section type="cta" background={background} aria-labelledby={id}>
	<div class="band | card stack" data-size="large" data-tone={block.tone}>
		<div class="copy | stack">
			<h2
				id={id}
				class:list={[brand ? 'text-h2' : 'text-h3']}
				dir="auto"
			>
				{block.heading}
			</h2>
			{block.text && (
				<p class:list={['text', brand && 'text-large']} dir="auto">
					{block.text}
				</p>
			)}
		</div>
		<div class="do | cluster">
			{block.actions.map((action) => (
				<Button
					href={action.href}
					variant={action.variant}
					inverse={brand || undefined}
					dir="auto"
				>
					{action.label}
				</Button>
			))}
		</div>
	</div>
</Section>
