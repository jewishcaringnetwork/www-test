---
/**
 * A call-to-action band for one of the page's main asks (`hierarchy.cta`).
 *
 * - `brand`: the loud one. A brand-blue band, h2 in white, inverse buttons
 *   (the gold donate button keeps its fill). Use sparingly, so it stays loud.
 * - `subtle`: a white `.card` panel (src/css/block/card.css) with ordinary
 *   buttons and a smaller heading, for support or a second ask (e.g. Home's
 *   support teaser). No gold: gold surfaces are for donation prompts, and
 *   the brand-gold fill is the donate button's.
 */
import type { CollectionEntry } from 'astro:content';
import Button from '~/components/button.astro';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'cta' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;
const brand = block.tone === 'brand';
const id = `cta-${
	block.heading.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-')
}`;
---

<style>
	.band {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-l) var(--space-xl);
		padding: var(--space-xl);

		@media (max-width: 48rem) {
			padding: var(--space-l) var(--space-m);
		}

		&[data-tone='brand'] {
			border-radius: var(--radius-xl);
			background: var(--color-surface-brand);
			color: var(--color-text-on-brand);

			h2 {
				color: var(--color-text-on-brand);
			}

			.text {
				color: var(--color-blue-100);
			}
		}

		&[data-tone='subtle'] {
			padding: var(--space-l) var(--space-xl);

			@media (max-width: 48rem) {
				padding: var(--space-m);
			}

			h2 {
				color: var(--color-text-heading);
			}

			.text {
				color: var(--color-text-secondary);
			}
		}
	}

	.copy {
		--stack-gap: var(--space-2xs);

		flex: 1 1 24rem;
		max-inline-size: 40rem;

		:is(h2, p) {
			margin-block-end: 0;
		}
	}

	/* One or two buttons in a row, wrapping when narrow. No quiet link: a
	 * second, lesser action is a secondary button. */
	.do {
		--cluster-gap: var(--space-xs) var(--space-m);
		--cluster-valign: center;

		flex: 0 1 auto;
	}
</style>

<Section type="cta" background={background} aria-labelledby={id}>
	<div class:list={['band', !brand && 'card']} data-tone={block.tone}>
		<div class="copy | stack">
			<h2
				id={id}
				class:list={[brand ? 'text-h2' : 'text-h3']}
				dir="auto"
			>
				{block.heading}
			</h2>
			{block.text && (
				<p class:list={['text', brand && 'text-large']} dir="auto">
					{block.text}
				</p>
			)}
		</div>
		<div class="do | cluster">
			{block.actions.map((action) => (
				<Button
					href={action.href}
					variant={action.variant}
					inverse={brand || undefined}
					dir="auto"
				>
					{action.label}
				</Button>
			))}
		</div>
	</div>
</Section>
