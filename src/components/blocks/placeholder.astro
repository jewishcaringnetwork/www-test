---
/**
 * Stand-in for a block type with no component yet. Shows the type and its
 * section heading so a page can be reviewed before every block is built.
 * It sits on its section background like a real block would.
 */
import type { CollectionEntry } from 'astro:content';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

interface Props {
	block: CollectionEntry<'pages'>['data']['blocks'][number];
	background: SectionBackground;
}

const { block, background } = Astro.props;
const heading = 'heading' in block ? block.heading : undefined;
---

<style>
	.box {
		--stack-gap: var(--space-3xs);

		padding: var(--space-m);
		border: 2px dashed var(--color-border-strong);
		border-radius: var(--radius-l);
		background: var(--color-surface-sunken);
		color: var(--color-text-secondary);

		:is(p, h2) {
			margin-block-end: 0;
		}
	}
</style>

<Section
	type={block.type}
	background={background}
	data-placeholder={block.type}
>
	<div class="box | stack">
		<p class="text-label">Placeholder: {block.type} block (not built yet)</p>
		{heading && <h2 class="text-h3" dir="auto">{heading}</h2>}
	</div>
</Section>
