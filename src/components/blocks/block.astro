---
/**
 * Renders one page block by its `type`. Each type gets its own component in
 * this folder, taking `{ block, background }` with `block` narrowed to that
 * type; register it in `components`. Types without one render a visible
 * placeholder.
 *
 * `index` is the block's position on the page, which sets its background
 * (`sectionBackground`); components pass it on to `Section`.
 */
import type { CollectionEntry } from 'astro:content';
import {
	type SectionBackground,
	sectionBackground,
} from '~/lib/section-background';
import Cards from './cards.astro';
import Contact from './contact.astro';
import Cta from './cta.astro';
import MediaText from './media-text.astro';
import People from './people.astro';
import Placeholder from './placeholder.astro';
import Prose from './prose.astro';

type Block = CollectionEntry<'pages'>['data']['blocks'][number];

interface Props {
	block: Block;
	index: number;
}

type Components = {
	[T in Block['type']]?: (props: {
		block: Extract<Block, { type: T }>;
		background: SectionBackground;
	}) => unknown;
};

const components: Components = {
	prose: Prose,
	people: People,
	cards: Cards,
	mediaText: MediaText,
	contact: Contact,
	cta: Cta,
};

const { block, index } = Astro.props;
const Component = components[block.type] ?? Placeholder;
---

<Component
	block={block as never}
	background={sectionBackground(block, index)}
/>
