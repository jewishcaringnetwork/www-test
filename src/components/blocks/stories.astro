---
/**
 * Teasers for family stories: a grid of `.card`s (src/css/block/card.css),
 * each with the story title linking to its page, the summary, and the date
 * and author (or nothing, for an anonymous story). Shows the latest `count`
 * stories, all of them for `count: "all"`, or the `pick`ed ones in order.
 *
 * Only approved stories appear (`approvedStories`); a picked story that
 * isn't approved is skipped. With none to show, a "Coming soon" panel
 * stands in, so the page never shows an empty list.
 */
import type { CollectionEntry } from 'astro:content';
import type { SectionBackground } from '~/lib/section-background';
import { approvedStories, storyDate, storyHref } from '~/lib/stories';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'stories' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;
const approved = await approvedStories();
const stories = block.pick
	? block.pick.flatMap((ref) => approved.filter((s) => s.id === ref.id))
	: block.count === 'all'
	? approved
	: approved.slice(0, block.count);
---

<style>
	.items {
		--grid-gap: var(--space-m);
		--grid-item-min: 18rem;
		--grid-item-max: none;
	}

	/* Spacing between the parts is the card's (src/css/block/card.css) */
	.card :is(h3, p) {
		margin-block-end: 0;
	}

	h3 {
		color: var(--color-text-primary);
	}

	.summary,
	.byline,
	.soon p {
		color: var(--color-text-secondary);
	}

	.byline {
		margin-block-start: auto;
		padding-block-start: var(--space-xs);
		font-size: var(--font-size-s);
	}

	.soon {
		max-inline-size: 40rem;
	}

	.soon .text-label {
		color: var(--color-text-heading);
	}
</style>

<Section
	type="stories"
	background={background}
	heading={block.heading}
	intro={block.intro}
>
	{stories.length
		? (
		 <ul role="list" class="items | grid">
			 {stories.map((story) => (
				 <li class="card | stack">
					 <h3 class="text-h3" dir="auto">
						 <a href={storyHref(story)}>{story.data.title}</a>
					 </h3>
					 <p class="summary" dir="auto">{story.data.summary}</p>
					 <p class="byline" dir="auto">
						 <time datetime={story.data.date.toISOString().slice(0, 10)}>
							 {storyDate(story.data.date)}
						 </time>
						 {story.data.author && <>, {story.data.author}</>}
					 </p>
				 </li>
			 ))}
		 </ul>
	 )
		: (
		 <div class="soon | card | stack">
			 <p class="text-label">Coming soon</p>
			 <p dir="auto">
				 Stories from families and volunteers will appear here.
			 </p>
		 </div>
	 )}
</Section>
