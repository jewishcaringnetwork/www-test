---
/**
 * Contact details for one or two locations, each a panel: name, address,
 * tap-to-call phone, optional email, a photo of the place and a quiet link
 * (e.g. to Plan Your Stay). Every detail is the same size, so the place's
 * name leads; the loud way to call (e.g. Tikva House's "Request a stay")
 * belongs to the hero or a CTA, not this reference panel.
 *
 * Two locations sit side by side when there's room. Each panel lays itself
 * out by its own width (a container query), so a photo goes beside the
 * details only in a wide panel and above them in a narrow one.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from '~/components/icon.astro';
import { telHref } from '~/config';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'contact' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;
// Under a section heading the place names are h3; without one, they head
// their own sections of the page, so h2
const Name = block.heading ? 'h3' : 'h2';
const imageSizes = block.locations.length > 1
	? '(max-width: 48rem) 100vw, 36rem'
	: '(max-width: 48rem) 100vw, 28rem';
---

<style>
	/* Same gap as the cards block's grid */
	.locations {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
		gap: var(--space-m);
		padding: 0;
		list-style: none;
	}

	.location {
		display: grid;
		container-type: inline-size;
	}

	/*
	 * A large .card whose photo runs to its edges: the card's padding moves
	 * to the details.
	 */
	.panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		overflow: hidden;
		padding: 0;

		&:has(> .photo) {
			@container (min-width: 48rem) {
				grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			}
		}
	}

	/* The card rhythm (src/css/block/card.css): 12px, 24px above the link */
	.details {
		--stack-gap: var(--space-xs);

		padding: var(--card-padding, var(--space-m));

		/* Bottom only: the top margin is the stack's gap */
		:is(h2, h3, p, dl, dd) {
			margin-block-end: 0;
		}
	}

	.name {
		color: var(--color-text-heading);
	}

	dl {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: var(--space-s) var(--space-m);
		align-items: baseline;

		@container (max-width: 30rem) {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3xs);

			dd + dt {
				margin-block-start: var(--space-xs);
			}
		}
	}

	dt {
		color: var(--color-text-secondary);
	}

	address {
		font-style: normal;
		line-height: var(--leading-normal, 1.5);
	}

	.email {
		overflow-wrap: anywhere;
	}

	.quiet {
		--stack-gap: var(--space-m);

		display: inline-flex;
		align-items: center;
		gap: var(--space-3xs);
		min-block-size: 44px;
		font-family: var(--font-family-heading);
		font-weight: var(--font-weight-medium);
	}

	/* Brand color shows (with the alt text) if the photo fails to load */
	/* Narrow panel: the photo sits above the details */
	.photo {
		position: relative;
		order: -1;
		aspect-ratio: 16 / 9;
		background: var(--color-surface-brand);
		color: var(--color-text-on-brand);

		img {
			position: absolute;
			inset: 0;
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
			/* Exteriors: favour the entrance over sky */
			object-position: 50% 75%;
		}

		/* Wide panel: the details set its height; the photo fills it */
		@container (min-width: 48rem) {
			order: 0;
			min-block-size: 18rem;
			aspect-ratio: auto;
		}
	}
</style>

<Section
	type="contact"
	background={background}
	heading={block.heading}
	intro={block.intro}
>
	<ul role="list" class="locations">
		{block.locations.map((place) => (
			<li class="location">
				<div class="panel | card" data-size="large">
					<div class="details | stack">
						<Name class="name | text-h3" dir="auto">{place.name}</Name>
						<dl class="text-body">
							<dt class="text-label">Phone</dt>
							<dd>
								<a href={telHref(place.phone)}>{place.phone}</a>
							</dd>
							<dt class="text-label">Address</dt>
							<dd>
								<address>
									{place.address.street}<br />{place.address.city},{' '}
									{place.address.state} {place.address.zip}
								</address>
							</dd>
							{place.email && (
								<>
									<dt class="text-label">Email</dt>
									<dd>
										<a class="email" href={`mailto:${place.email}`}>
											{place.email}
										</a>
									</dd>
								</>
							)}
						</dl>
						{place.link && (
							<a class="quiet" href={place.link.href} dir="auto">
								{place.link.label}
								<Icon name="arrow-right" size={16} />
							</a>
						)}
					</div>
					{place.image && (
						<div class="photo">
							<Image
								src={place.image.src}
								alt={place.image.alt}
								widths={[480, 720, 960]}
								sizes={imageSizes}
							/>
						</div>
					)}
				</div>
			</li>
		))}
	</ul>
</Section>
