---
/**
 * JCN's Admire donation form in an iframe (docs/adr/0006). Gifts, receipts
 * and the form's look are Admire's.
 *
 * Fund preselect: `/donate?fund=tikva-house` preselects "Tikva House" in the
 * form's Funds dropdown. The page is static, so a small inline script reads
 * the query and sets the iframe `src`. Only slugs from `funds.ts` get
 * through; anything else leaves the plain form.
 *
 * Size: Admire has no resize script and the frame is cross-origin, so the
 * frame's size is fixed per layout. Admire's page is `min-height: 100vh`, so
 * any sideways overflow in the frame adds both scrollbars. Measured 11/23:
 *
 * - Width: from about 540 to 690px of frame width, Admire's card sits
 *   off-centre and overflows by up to 40px. So the frame is at most 520px
 *   wide (narrow layout) until the container fits the wide layout at 704px.
 *   The narrow layout still overflows by 2-4px, even on Admire's own page;
 *   phones overlay their scrollbars, so that's a 2px sideways pan there.
 *   Desktop browsers with classic scrollbars show both in a narrow window.
 * - Height: 1387px narrow and 1251px wide by default, up to 1555 and 1419px
 *   with "Monthly" and "Enter address manually", plus about 85px for the
 *   Cloudflare check Admire shows only when embedded. The heights below
 *   cover that. Anything taller still scrolls inside the frame rather than
 *   being cut off, so `scrolling` stays on.
 *
 * Re-measure if Admire changes the form.
 */
import type { CollectionEntry } from 'astro:content';
import Phosphor from '~/components/phosphor.astro';
import { donateEmbedSrc, funds, fundSlug } from '~/schemas/funds';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'form' }
>;

interface Props {
	block: Block;
}

const { block } = Astro.props;
const src = donateEmbedSrc();
const srcBySlug = Object.fromEntries(
	funds.map((fund) => [fundSlug(fund), donateEmbedSrc(fund)]),
);
---

<style>
	.embed {
		container-type: inline-size;
		max-inline-size: 704px;
	}

	iframe {
		display: block;
		inline-size: 100%;
		max-inline-size: 520px;
		block-size: 1660px;
		border: 0;
		border-radius: var(--radius-l);
		/* A light panel while the form loads, close to Admire's own */
		background: var(--color-surface-card);

		@container (min-width: 704px) {
			max-inline-size: none;
			block-size: 1520px;
		}
	}

	.fallback {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3xs);
		margin-block-end: 0;
		color: var(--color-text-secondary);

		a {
			display: inline-flex;
			align-items: center;
			gap: var(--space-3xs);
			min-block-size: 44px;
		}
	}
</style>

<Section type="form" heading={block.heading} intro={block.intro}>
	<div class="embed">
		<iframe
			data-donate-embed
			title="Donation form"
			src={src}
			allow="payment"
		></iframe>
	</div>
	<p class="fallback | text-body">
		Form not loading?
		<a data-donate-fallback href={src} target="_blank" rel="noopener">
			Open the donation form in a new tab
			<Phosphor name="arrow-square-out" size={16} />
		</a>
	</p>
</Section>

<script is:inline define:vars={{ srcBySlug }}>
	const fund = new URLSearchParams(location.search).get('fund');
	const src = Object.hasOwn(srcBySlug, fund ?? '') ? srcBySlug[fund] : null;
	if (src) {
		document.querySelector('[data-donate-embed]').src = src;
		document.querySelector('[data-donate-fallback]').href = src;
	}
</script>
