---
/**
 * People from one group of the `people` collection, sorted by `order`, then
 * name. Every group (leadership, board, staff) uses the same item: a square
 * portrait, the name as an h3 and an optional role. A person without a photo
 * gets a placeholder of the same size, so names and roles stay aligned
 * across a row.
 */
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import Phosphor from '~/components/phosphor.astro';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'people' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;

const people = (await getCollection(
	'people',
	(person) => person.data.group === block.group,
))
	.map((person) => person.data)
	.sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
---

<style>
	.people {
		--grid-gap: var(--space-l) var(--space-m);
		--grid-item-min: 9rem;
		--grid-item-max: 13rem;
	}

	.person {
		--stack-gap: var(--space-3xs);

		:is(h3, p) {
			margin-block-end: 0;
		}
	}

	/* Photo and placeholder share one frame, so a missing photo keeps the row */
	.portrait {
		display: grid;
		place-items: center;
		inline-size: 100%;
		aspect-ratio: 1;
		margin-block-end: var(--space-xs);
		overflow: hidden;
		border-radius: var(--radius-l);
		background: var(--color-surface-sunken);
		color: var(--color-text-subtle);

		img {
			inline-size: 100%;
			block-size: 100%;
			object-fit: cover;
			/* Faces sit in the upper part of a portrait */
			object-position: 50% 25%;
		}
	}

	h3 {
		font-size: var(--font-size-l);
	}

	.role {
		color: var(--color-text-secondary);
	}
</style>

<Section
	type="people"
	background={background}
	heading={block.heading}
	intro={block.intro}
>
	<ul role="list" class="people | grid">
		{people.map((person) => (
			<li class="person | stack">
				<div class="portrait">
					{person.photo
						? (
						 <Image
							 src={person.photo.src}
							 alt={person.photo.alt}
							 widths={[208, 416]}
							 sizes="13rem"
						 />
					 )
						: <Phosphor name="user" weight="light" size={56} />}
				</div>
				<h3 class="text-h3" dir="auto">{person.name}</h3>
				{person.role && <p class="role" dir="auto">{person.role}</p>}
			</li>
		))}
	</ul>
</Section>
