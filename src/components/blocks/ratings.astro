---
/**
 * JCN's charity ratings as a page section: About's Financials. The badges
 * are `charity-ratings.astro`, the same ones the footer and Donate page show,
 * so the ratings come from `finance` in content/site.json and never disagree
 * between pages. Here they're the section's whole content, so they're drawn
 * larger, under the shared section header.
 *
 * Without any ratings in site.json the section isn't rendered at all, rather
 * than leaving a heading over nothing.
 */
import type { CollectionEntry } from 'astro:content';
import CharityRatings from '~/components/charity-ratings.astro';
import { finance } from '~/config';
import type { SectionBackground } from '~/lib/section-background';
import Section from './section.astro';

type Block = Extract<
	CollectionEntry<'pages'>['data']['blocks'][number],
	{ type: 'ratings' }
>;

interface Props {
	block: Block;
	background: SectionBackground;
}

const { block, background } = Astro.props;
const hasRatings = Boolean(finance.candid || finance.charityNavigator);
---

<style>
	.ratings {
		--rating-size: 128px;

		:global(ul) {
			--cluster-gap: var(--space-l) var(--space-xl);
		}
	}
</style>

{hasRatings && (
	<Section
		type="ratings"
		background={background}
		heading={block.heading}
		intro={block.intro}
	>
		<div class="ratings">
			<CharityRatings />
		</div>
	</Section>
)}
