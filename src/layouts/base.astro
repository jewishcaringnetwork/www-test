---
import 'virtual:sugarcube.css';
import '~/css/main.css';
import '@fontsource-variable/signika';

import { site } from '~/config';
import Banner from './_banner.astro';
import Footer from './_footer.astro';
import Header from './_header.astro';

export interface Props {
	title: string | false;
	ignore?: boolean;
}

const title = [Astro.props.title || [], site.name].flat().join(' | ');
---

<style>
	#root {
		--cover-gap: 0;
	}

	.skip-link {
		position: absolute;
		top: var(--space-2xs);
		left: var(--space-2xs);
		z-index: 20;
		padding: var(--space-2xs) var(--space-s);
		border-radius: var(--radius-m);
		background: var(--color-surface-card);
		box-shadow: var(--shadow-m);

		&:not(:focus) {
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			padding: 0;
		}
	}
</style>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<link rel="icon" href="data:," />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{Astro.props.ignore && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div id="root" class="cover">
			<Banner />
			<Header />
			<main id="main" data-grow>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
