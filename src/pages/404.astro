---
import Button from '~/components/button.astro';
import Icon from '~/components/icon.astro';
import { type NavLink, site } from '~/config';
import Layout from '~/layouts/base.astro';

const moreLinks: NavLink[] = [
	{ label: 'Services', href: '/services' },
	{ label: 'Tikva House', href: '/tikva-house' },
	{ label: 'Ways to Give', href: '/donate' },
	{ label: 'Volunteer', href: '/get-involved/volunteer' },
	{ label: 'Contact us', href: '/contact' },
];
---

<style>
	.not-found {
		--stack-gap: var(--space-m);
		--stack-halign: center;

		max-inline-size: 40rem;
		margin-inline: auto;
		padding-block: var(--space-3xl);
		padding-inline: var(--space-l);
		text-align: center;

		@media (max-width: 60rem) {
			padding-block: var(--space-2xl);
			padding-inline: var(--space-s);
		}

		:is(p, h1, h2) {
			margin-block-end: 0;
		}
	}

	.status,
	.lead,
	.more h2 {
		color: var(--color-text-secondary);
	}

	h1 {
		color: var(--color-brand-blue);
	}

	.lead {
		max-inline-size: 34rem;
	}

	.actions {
		--cluster-gap: var(--space-xs);

		justify-content: center;
		margin-block-start: var(--space-l);
	}

	.more {
		--stack-gap: var(--space-2xs);

		margin-block-start: var(--space-xl);

		ul {
			--cluster-gap: var(--space-3xs) var(--space-m);

			justify-content: center;
		}

		a {
			display: inline-flex;
			align-items: center;
			min-block-size: 44px;
			color: var(--color-text-link);
			text-underline-offset: 3px;
		}
	}
</style>

<Layout title="Page not found" ignore>
	<div class="not-found | stack">
		<p class="status | text-label">Error 404</p>
		<h1 class="text-display">We can't find that page</h1>
		<p class="lead | text-large">
			The link may be out of date, or the page may have moved. Can't find what
			you're looking for? Call us. We're glad to help.
		</p>
		<div class="actions | cluster">
			<Button variant="primary" href={site.phone.href}>
				<Icon slot="icon" name="phone" />Call {site.phone.display}
			</Button>
			<Button variant="secondary" href="/">Go to the home page</Button>
		</div>

		<nav class="more | stack" aria-labelledby="more-heading">
			<h2 id="more-heading">Or try one of these:</h2>
			<ul role="list" class="cluster">
				{moreLinks.map(({ label, href }) => (
					<li><a href={href}>{label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</Layout>
