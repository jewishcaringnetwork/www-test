---
import type { ComponentProps } from 'astro/types';
import Button from '~/components/button.astro';
import Hero from '~/components/hero.astro';
import Icon from '~/components/icon.astro';
import { type NavLink, org, telHref } from '~/config';
import Layout from '~/layouts/base.astro';

const hero: ComponentProps<typeof Hero>['hero'] = {
	type: 'hero',
	heading: "We can't find that page",
	lead:
		"The link may be out of date, or the page may have moved. Can't find what you're looking for? Call us. We're glad to help.",
	// filled by the actions slot below, so the Call button can have an icon
	actions: [],
};

const moreLinks: NavLink[] = [
	{ label: 'Services', href: '/services' },
	{ label: 'Tikva House', href: '/tikva-house' },
	{ label: 'Donate', href: '/donate' },
	{ label: 'Volunteer', href: '/get-involved/volunteer' },
	{ label: 'Contact us', href: '/contact' },
];
---

<style>
	.status {
		margin-block-end: 0;
		color: var(--color-text-secondary);
	}

	.more {
		--container-size: 40rem;
		--stack-gap: var(--space-2xs);

		padding-block-end: var(--space-3xl);
		padding-inline: var(--space-l);
		text-align: center;

		@media (max-width: 60rem) {
			padding-block-end: var(--space-2xl);
			padding-inline: var(--space-s);
		}

		h2 {
			margin-block-end: 0;
			color: var(--color-text-secondary);
		}

		ul {
			--cluster-gap: var(--space-3xs) var(--space-m);

			justify-content: center;
		}

		a {
			display: inline-flex;
			align-items: center;
			min-block-size: 44px;
			color: var(--color-text-link);
			text-underline-offset: 3px;
		}
	}
</style>

<Layout title="Page not found" ignore>
	<Hero hero={hero}>
		<p slot="eyebrow" class="status | text-label">Error 404</p>
		<Fragment slot="actions">
			<Button variant="primary" href={telHref(org.phone)}>
				<Icon slot="icon" name="phone" />Call {org.phone}
			</Button>
			<Button variant="secondary" href="/">Go to the home page</Button>
		</Fragment>
	</Hero>

	<nav class="more | stack container" aria-labelledby="more-heading">
		<h2 id="more-heading">Or try one of these:</h2>
		<ul role="list" class="cluster">
			{moreLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
		</ul>
	</nav>
</Layout>
