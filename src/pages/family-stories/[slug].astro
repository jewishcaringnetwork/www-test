---
/**
 * One family story at `/family-stories/<file name>`, from
 * `content/stories/*.md`. Only approved stories get a page
 * (`approvedStories`), so an unapproved one has no URL and stays out of the
 * sitemap. With none approved, this route builds nothing.
 *
 * Laid out by the post layout. The story's Markdown is rendered as written:
 * the families' wording is never changed. The link at the end goes back to
 * the archive, which carries the "Share your story" ask.
 */
import { getCollection, render } from 'astro:content';
import PostLayout from '~/layouts/post.astro';
import { approvedStories, type Story, storyProblems } from '~/lib/stories';

export async function getStaticPaths() {
	const problems = await storyProblems();
	if (problems.length) throw new Error(problems.join('\n'));
	const stories = await approvedStories();
	// A story named like a page under /family-stories/ (e.g. share.md)
	// would hide that page.
	const pages = new Set((await getCollection('pages')).map((p) => p.id));
	const clashes = stories.filter((s) => pages.has(`family-stories/${s.id}`));
	if (clashes.length) {
		throw new Error(
			clashes.map((s) =>
				`content/stories/${s.id}.md clashes with the page /family-stories/${s.id}; rename the story file.`
			).join('\n'),
		);
	}
	return stories.map((story) => ({
		params: { slug: story.id },
		props: { story },
	}));
}

interface Props {
	story: Story;
}

const { story } = Astro.props;
const { title, summary, date, author } = story.data;
const { Content } = await render(story);
---

<PostLayout
	title={title}
	lead={summary}
	date={date}
	byline={author && `By ${author}`}
	back={{ href: '/family-stories', label: 'Family Stories' }}
	next={{ href: '/family-stories', label: 'Read more stories' }}
>
	<Content />
</PostLayout>
