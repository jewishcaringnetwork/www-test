---
/**
 * Every page in `content/pages/`: the file path is the URL, so
 * `content/pages/about/history.json` is `/about/history`. A page is the base
 * layout, its header (plain, or a hero on landing pages) and its blocks;
 * there is no separate page layout. `content/pages/index.json` is Home (`/`),
 * whose browser tab shows the site name alone.
 *
 * Pages in `ownRoute` have a route of their own that renders the same JSON
 * around something blocks can't express, so they're skipped here.
 */
import { getCollection } from 'astro:content';
import Block from '~/components/blocks/block.astro';
import Header from '~/components/header.astro';
import Hero from '~/components/hero.astro';
import Layout from '~/layouts/base.astro';
import { sectionBackgrounds } from '~/lib/section-background';
import { duplicateForms } from '~/schemas/forms';

export async function getStaticPaths() {
	// Page ids rendered by their own route, e.g. an archive
	const ownRoute = new Set([
		'family-stories', // src/pages/family-stories/index.astro
	]);
	const pages = await getCollection('pages');
	const errors = duplicateForms(pages.map((page) => ({
		id: page.id,
		forms: page.data.blocks.flatMap((b) => b.type === 'form' ? [b.form] : []),
	})));
	if (errors.length) throw new Error(errors.join('\n'));
	return pages.filter((page) => !ownRoute.has(page.id)).map((page) => ({
		params: { slug: page.id === 'index' ? undefined : page.id },
		props: { page },
	}));
}

const { page } = Astro.props;
const { title, description, noindex, header, blocks } = page.data;
const backgrounds = sectionBackgrounds(
	header.type,
	blocks.map((block) => block.type),
);
---

<Layout
	title={page.id === 'index' ? false : title}
	description={description}
	ignore={noindex}
>
	{header.type === 'hero'
		? <Hero hero={header} />
		: <Header header={header} title={title} />}
	{blocks.map((block, i) => (
		<Block block={block} background={backgrounds[i]} />
	))}
</Layout>
